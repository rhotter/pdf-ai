{
  "name": "readatron",
  "description": "Chrome extension that adds an AI chat sidebar to PDF pages",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "upload:chrome": "wxt zip && chrome-webstore-upload upload --source .output/readatron-$npm_package_version-chrome.zip",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.41",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-scroll-area": "^1.2.3",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@radix-ui/react-use-controllable-state": "^1.2.2",
    "ai": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.446.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "streamdown": "^2.4.0",
    "tailwind-merge": "^2.5.2",
    "use-stick-to-bottom": "^1.1.3"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@thedutchcoder/postcss-rem-to-px": "^0.0.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@wxt-dev/module-react": "^1.1.2",
    "autoprefixer": "^10.4.20",
    "chrome-webstore-upload-cli": "^3.5.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.7.0",
    "wxt": "^0.20.0"
  }
}
